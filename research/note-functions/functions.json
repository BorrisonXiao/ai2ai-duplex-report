{
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "add_note",
        "description": "Save a distinct useful fact or unresolved issue. The program assigns its note ID.",
        "parameters": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "object",
              "properties": {
                "topic": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "fact": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "observed",
                    "proposed",
                    "agreed",
                    "completed",
                    "cancelled",
                    "unresolved"
                  ]
                }
              },
              "required": [
                "topic",
                "fact",
                "owner",
                "status"
              ],
              "additionalProperties": false
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true
            }
          },
          "required": [
            "fields",
            "source_ids"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "update_note",
        "description": "Change the SAME task and aspect using new evidence; retain the old version automatically. Add complementary evidence with empty changes only if it is useful.",
        "parameters": {
          "type": "object",
          "properties": {
            "note_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "changes": {
              "type": "object",
              "properties": {
                "topic": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "fact": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "observed",
                    "proposed",
                    "agreed",
                    "completed",
                    "cancelled",
                    "unresolved"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true
            }
          },
          "required": [
            "note_id",
            "changes",
            "source_ids"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "delete_note",
        "description": "Remove a mistaken or duplicate note from the active view. A cancelled or superseded plan should be updated, preserving its historical meaning. The audit retains deletion and reason.",
        "parameters": {
          "type": "object",
          "properties": {
            "note_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "required": [
            "note_id",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "link_notes",
        "description": "Link existing notes about related aspects. Same-task changes belong in update_note; do not merge different tasks merely because they share a word.",
        "parameters": {
          "type": "object",
          "properties": {
            "first_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "second_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "relation": {
              "type": "string",
              "enum": [
                "revises",
                "confirms",
                "explains",
                "qualifies",
                "refers_to"
              ]
            }
          },
          "required": [
            "first_id",
            "second_id",
            "relation"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "no_change",
        "description": "No useful new information; do not add routine acknowledgements or duplicate facts.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      }
    }
  ],

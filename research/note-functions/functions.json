  "tools": [
    {
      "type": "function",
      "function": {
        "name": "add_note",
        "description": "Save one distinct task/aspect or unresolved issue. The program assigns its note ID.",
        "parameters": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "fact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "status": {
              "type": "string",
              "enum": [
                "observed",
                "proposed",
                "agreed",
                "completed",
                "cancelled",
                "unresolved"
              ]
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true
            }
          },
          "required": [
            "topic",
            "fact",
            "owner",
            "status",
            "source_ids"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",

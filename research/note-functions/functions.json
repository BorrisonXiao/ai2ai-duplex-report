    {
      "type": "function",
      "function": {
        "name": "delete_note",
        "description": "Remove a mistaken or duplicate active note; preserve its deletion record. A cancelled task is a status update.",
        "parameters": {
          "type": "object",
          "properties": {
            "note_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "required": [
            "note_id",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "link_notes",
        "description": "Link two existing notes; do not merge separate tasks, quantities or participant-specific access reports.",
        "parameters": {
          "type": "object",
          "properties": {
            "first_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "second_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "relation": {
              "type": "string",
              "enum": [
                "revises",
                "confirms",
                "explains",
                "qualifies",
                "refers_to"
              ]
            }
          },
          "required": [
            "first_id",
            "second_id",
            "relation"
          ],
          "additionalProperties": false
        }
      }
    },
    {

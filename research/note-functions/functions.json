              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "fact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "status": {
              "type": "string",
              "enum": [
                "observed",
                "proposed",
                "agreed",
                "completed",
                "cancelled",
                "unresolved"
              ]
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 5,
